NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/house-of-rani?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# CORS — browser sends Origin = exact URL user opened (https + host). Use FRONTEND_URLS in production.
# Only origins you list here (or FRONTEND_URL) are allowed unless you opt in below.
# For www + apex, either list both URLs explicitly or set:
# CORS_MIRROR_WWW_APEX=true
# (mirrors www↔apex only for simple name.tld hosts; keep false unless you understand the tradeoff)
# FRONTEND_URLS=https://thehouseofrani.com,https://www.thehouseofrani.com
FRONTEND_URL=http://localhost:3000

# Meta Conversions API — same pixel as frontend; token from Events Manager → pixel → Settings → Conversions API → Generate access token
META_PIXEL_ID=
META_CAPI_TOKEN=

# IndexNow (Bing instant indexing) — same key as frontend INDEXNOW_API_KEY / NEXT_PUBLIC_INDEXNOW_API_KEY
# INDEXNOW_API_KEY=your-generated-indexnow-key

# ── Email (Gmail inbox / not spam: DNS + auth matter more than code) ─────────
# 1) Send from YOUR domain (e.g. noreply@yourdomain.com), not a random Gmail address,
#    unless you use that Gmail account’s SMTP with “Send mail as” verified.
# 2) In DNS for the domain: publish SPF (include your SMTP provider), DKIM (provider or below),
#    and DMARC (e.g. _dmarc TXT v=DMARC1; p=none; rua=mailto:you@yourdomain.com — tighten later).
# 3) Use a reputable SMTP (Google Workspace, Resend, SendGrid, Mailgun, Amazon SES, etc.).
# 4) MAIL_REPLY_TO should be a monitored address on the same domain when possible.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=app-specific-password
#
# MAIL_FROM=The House of Rani <noreply@yourdomain.com>
# MAIL_REPLY_TO=support@yourdomain.com
#
# Optional: sign mail with DKIM (private key PEM). Improves Gmail trust if DNS TXT matches.
# DKIM_DOMAIN=yourdomain.com
# DKIM_SELECTOR=default
# DKIM_PRIVATE_KEY_PATH=/path/to/dkim-private.pem
# Or single-line PEM with \n for newlines:
# DKIM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Delhivery B2C (optional — automated waybill + shipment + tracking sync for admin)
# Token from Delhivery panel; pickup name must match registered warehouse exactly (case/spacing).
# DELHIVERY_USE_STAGING=true uses https://staging-express.delhivery.com instead of production track.delhivery.com
# DELHIVERY_TRACK_SYNC_MS=1200000  (default 20 min) — how often shipped Delhivery orders poll the track API; set 0 to disable timer
# DELHIVERY_TAT_PATH=  (optional override URL path/query for TAT API if your account uses a non-default route)
# DELHIVERY_API_TOKEN=
# DELHIVERY_PICKUP_LOCATION_NAME=
# DELHIVERY_ORIGIN_PINCODE=
# DELHIVERY_USE_STAGING=false

# ── Admin AI (Groq) — dashboard brief, email draft, ask-store, etc. ─────────
# GROQ_API_KEY=
# AI_MODEL=llama-3.1-8b-instant
# AI_DAILY_BRIEF_TTL_SEC=86400
# AI_EXPLAIN_CACHE_TTL_SEC=3600
# AI_DRAFT_CACHE_TTL_SEC=1800
# AI_ADMIN_HOURLY_MAX=30
# AI_MAX_TOKENS=1024
# AI_TEMPERATURE=0.35

# ── Blog AI (Gemini) — journal drafts; RAG + SEO same; only LLM changes ────
# Get key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MAX_TOKENS=4096
# GEMINI_TEMPERATURE=0.4
# GEMINI_REQUEST_TIMEOUT_MS=60000
# AI_BLOG_PROVIDER=gemini
# (default: gemini when GEMINI_API_KEY set; else groq. Set AI_BLOG_PROVIDER=groq to force Groq for blogs)

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Redis (BullMQ / rate limit). Prefer one URL, or omit URL and use HOST/PORT/PASSWORD.
# Redis Cloud: password required; TLS often needs rediss:// (double s).
# REDIS_URL=redis://default:YOUR_PASSWORD@redis-xxxxx.cloud.redislabs.com:14167
# REDIS_URL=rediss://default:YOUR_PASSWORD@redis-xxxxx.cloud.redislabs.com:14167
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
#
# BullMQ: production Redis should use maxmemory-policy noeviction (job keys must not be evicted).
# In development, Docker/default Redis often uses volatile-lru — BullMQ skips INFO/eviction checks
# unless NODE_ENV=production. To force checks in dev: BULLMQ_SKIP_REDIS_VERSION_CHECK=false
# To silence checks in production (not recommended): BULLMQ_SKIP_REDIS_VERSION_CHECK=true

# ── Auth hardening (optional) ───────────────────────────────────────────────
# Cloudflare Turnstile — set secret; set TURNSTILE_ENFORCE=true to require token on login/signup/OTP send
# TURNSTILE_SECRET_KEY=
# TURNSTILE_ENFORCE=false
# Refresh rotation limits (Redis required for multi-instance)
# REFRESH_TOKEN_DAYS=30
# REFRESH_TOKEN_WINDOW_SEC=3600
# REFRESH_TOKEN_HOURLY_MAX=40
# REFRESH_TOKEN_IP_HOURLY_MAX=120

# ── OpenTelemetry (traces + metrics) ────────────────────────────────────────
# OTEL_ENABLED=true               # Set false to disable entirely (default: auto-detect)
# OTEL_SERVICE_NAME=house-of-rani-backend
#
# OTLP endpoint (Jaeger, Tempo, Honeycomb, Grafana Cloud, Datadog, OTEL Collector, etc.)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # OTLP/HTTP base URL
#
# Override individual signal endpoints if needed:
# OTEL_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
#
# Auth header for cloud vendors (e.g. Honeycomb / Grafana Cloud):
# OTEL_HEADERS=x-honeycomb-team=YOUR_API_KEY
# OTEL_HEADERS=Authorization=Basic BASE64_ENCODED_TOKEN
#
# Sampling (1.0 = 100%, 0.2 = 20%  default: 1.0 dev / 0.2 prod)
# OTEL_TRACES_SAMPLE_RATE=1.0
#
# Metrics export interval in ms (default: 30000 = 30 s)
# OTEL_METRICS_INTERVAL_MS=30000
#
# Diagnostic log level: none | error | warn | info | debug (default: warn)
# OTEL_LOG_LEVEL=warn
#
# ─── Quick-start backends ────────────────────────────────────────────────────
# Jaeger all-in-one (local dev):
#   docker run -d --name jaeger -p 16686:16686 -p 4318:4318 jaegertracing/all-in-one:latest
#   Then set: OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#   UI at: http://localhost:16686
#
# Grafana Tempo + Prometheus (docker compose included in docs/docker/):
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#
# Honeycomb.io (free tier, cloud):
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
#   OTEL_HEADERS=x-honeycomb-team=YOUR_KEY
#
# Datadog:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318  (via DD Agent)
#   OR OTEL_EXPORTER_OTLP_ENDPOINT=https://trace.agent.datadoghq.com
#   OTEL_HEADERS=dd-api-key=YOUR_KEY
