NODE_ENV=development
PORT=5000
# Production: leave unset/false. Set true only to expose Swagger at /api/docs.
# ENABLE_API_DOCS=false

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/house-of-rani?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
# Required in production — Razorpay Dashboard → Webhooks → secret for HMAC verify
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# CORS — browser sends Origin = exact URL user opened (https + host). Use FRONTEND_URLS in production.
# Only origins you list here (or FRONTEND_URL) are allowed unless you opt in below.
# For www + apex, either list both URLs explicitly or set:
# CORS_MIRROR_WWW_APEX=true
# (mirrors www↔apex only for simple name.tld hosts; keep false unless you understand the tradeoff)
# FRONTEND_URLS=https://thehouseofrani.com,https://www.thehouseofrani.com
FRONTEND_URL=http://localhost:3000

# Meta Conversions API — same pixel as frontend; token from Events Manager → pixel → Settings → Conversions API → Generate access token
META_PIXEL_ID=
META_CAPI_TOKEN=
# Optional override; defaults to the current supported version.
META_GRAPH_API_VERSION=v25.0

# IndexNow (Bing instant indexing) — same key as frontend INDEXNOW_API_KEY / NEXT_PUBLIC_INDEXNOW_API_KEY
# INDEXNOW_API_KEY=your-generated-indexnow-key

# ── Email (Gmail inbox / not spam: DNS + auth matter more than code) ─────────
# 1) Send from YOUR domain (e.g. noreply@yourdomain.com), not a random Gmail address,
#    unless you use that Gmail account’s SMTP with “Send mail as” verified.
# 2) In DNS for the domain: publish SPF (include your SMTP provider), DKIM (provider or below),
#    and DMARC (e.g. _dmarc TXT v=DMARC1; p=none; rua=mailto:you@yourdomain.com — tighten later).
# 3) Use a reputable SMTP (Google Workspace, Resend, SendGrid, Mailgun, Amazon SES, etc.).
# 4) MAIL_REPLY_TO should be a monitored address on the same domain when possible.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=app-specific-password
#
# MAIL_FROM=The House of Rani <noreply@yourdomain.com>
# MAIL_REPLY_TO=support@yourdomain.com
#
# Optional: sign mail with DKIM (private key PEM). Improves Gmail trust if DNS TXT matches.
# DKIM_DOMAIN=yourdomain.com
# DKIM_SELECTOR=default
# DKIM_PRIVATE_KEY_PATH=/path/to/dkim-private.pem
# Or single-line PEM with \n for newlines:
# DKIM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Delhivery B2C (optional — automated waybill + shipment + tracking sync for admin)
# Token from Delhivery panel; pickup name must match registered warehouse exactly (case/spacing).
# DELHIVERY_USE_STAGING=true uses https://staging-express.delhivery.com instead of production track.delhivery.com
# DELHIVERY_TRACK_SYNC_MS=1200000  (default 20 min) — how often shipped Delhivery orders poll the track API; set 0 to disable timer
# DELHIVERY_TAT_PATH=  (optional override URL path/query for TAT API if your account uses a non-default route)
# DELHIVERY_API_TOKEN=
# DELHIVERY_PICKUP_LOCATION_NAME=
# DELHIVERY_ORIGIN_PINCODE=
# DELHIVERY_USE_STAGING=false

# ── Admin AI (Groq) — dashboard brief, email draft, ask-store, etc. ─────────
# GROQ_API_KEY=
# AI_MODEL=openai/gpt-oss-20b
# AI_DAILY_BRIEF_TTL_SEC=86400
# AI_EXPLAIN_CACHE_TTL_SEC=3600
# AI_DRAFT_CACHE_TTL_SEC=1800
# AI_ADMIN_HOURLY_MAX=30
# AI_MAX_TOKENS=1024
# AI_TEMPERATURE=0.35

# ── Blog AI (Gemini) — journal drafts; RAG + SEO same; only LLM changes ────
# Get key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MAX_TOKENS=4096
# GEMINI_TEMPERATURE=0.4
# GEMINI_REQUEST_TIMEOUT_MS=60000
# AI_BLOG_PROVIDER=gemini
# (default: gemini when GEMINI_API_KEY set; else groq. Set AI_BLOG_PROVIDER=groq to force Groq for blogs)

# Pagination (default page size everywhere)
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── WhatsApp Cloud API (Meta) — optional; no-ops when unset ─────────────────
# Create an app → WhatsApp → get Phone number ID + permanent token.
# Approve utility templates in WhatsApp Manager before enabling in production.
# WHATSAPP_ENABLED=true
# WHATSAPP_MARKETING_ENABLED=true
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_VERSION=v21.0
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_TEMPLATE_ORDER_CONFIRM=order_confirm
# WHATSAPP_TEMPLATE_SHIPPED=order_shipped
# WHATSAPP_TEMPLATE_ABANDONED=abandoned_cart
# WHATSAPP_TEMPLATE_REVIEW_INVITE=review_invite
# WHATSAPP_TEMPLATE_ORDER_STATUS=order_status
#   Body: {{1}} name, {{2}} order no, {{3}} status message, {{4}} order page URL
# WHATSAPP_TEMPLATE_ORDER_CANCELLED=order_cancelled
# WHATSAPP_TEMPLATE_OFFLINE_HANDOVER=offline_handover
#   Body: {{1}} name, {{2}} order no, {{3}} total, {{4}} invoice page URL
#   Optional URL button suffix → /dashboard/orders/{id}/invoice
# WHATSAPP_TEMPLATE_OFFLINE_THANKYOU=offline_order_thankyou
# WHATSAPP_TEMPLATE_ORDER_CANCELLED=order_cancelled
#
# Uptime / Better Stack: GET /api/health/live (process), /api/health (ready),
# /api/health/worker?token=... (job process heartbeat)
# HEALTHCHECK_TOKEN=long-random-string
# WORKER_HEARTBEAT_MS=60000
# WORKER_HEARTBEAT_TTL_SEC=180

# Redis (BullMQ / rate limit / cart sync / auth limits). Required in production.
# Local: npm run redis:up  then use URL below.
REDIS_URL=redis://127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_HEARTBEAT_MS=60000
#
# BullMQ: production Redis should use maxmemory-policy noeviction (job keys must not be evicted).
# In development, Docker/default Redis often uses volatile-lru — BullMQ skips INFO/eviction checks
# unless NODE_ENV=production. To force checks in dev: BULLMQ_SKIP_REDIS_VERSION_CHECK=false
# To silence checks in production (not recommended): BULLMQ_SKIP_REDIS_VERSION_CHECK=true

# ── Auth hardening (optional) ───────────────────────────────────────────────
# Cloudflare Turnstile — recovery widget thehouseofrani (sitekey on frontend).
# Prefer TURNSTILE_SECRET (Spin). Legacy alias TURNSTILE_SECRET_KEY still works.
# Enforce is on whenever a secret is set, unless TURNSTILE_ENFORCE=false.
# In NODE_ENV=development the API auto-uses Cloudflare's always-pass test secret
# (matches frontend localhost test sitekey). Force real secret with:
# TURNSTILE_USE_PROD_SECRET=true
# TURNSTILE_SECRET=
# TURNSTILE_ENFORCE=true
# TURNSTILE_SECRET_KEY=0x4AAAAAAD8xzubdxgpk_YOVdylYw6Cca5U
# Native app auth: set in production; mobile clients send X-App-Key header (Turnstile skipped only when key matches)
# MOBILE_APP_API_KEY=your_long_random_mobile_app_key
# Refresh rotation limits (Redis required for multi-instance)
# REFRESH_TOKEN_DAYS=30
# Admin panel TOTP 2FA — set true to block admin API until 2FA is enabled on the account
# ADMIN_2FA_REQUIRED=false
# REFRESH_TOKEN_WINDOW_SEC=3600
# REFRESH_TOKEN_HOURLY_MAX=40
# REFRESH_TOKEN_IP_HOURLY_MAX=120

# ── OpenTelemetry (traces + metrics) ────────────────────────────────────────
# OTEL_ENABLED=true               # Set false to disable entirely (default: auto-detect)
# OTEL_SERVICE_NAME=house-of-rani-backend
#
# OTLP endpoint (Jaeger, Tempo, Honeycomb, Grafana Cloud, Datadog, OTEL Collector, etc.)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # OTLP/HTTP base URL
#
# Override individual signal endpoints if needed:
# OTEL_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
#
# Auth header for cloud vendors (e.g. Honeycomb / Grafana Cloud):
# OTEL_HEADERS=x-honeycomb-team=YOUR_API_KEY
# OTEL_HEADERS=Authorization=Basic BASE64_ENCODED_TOKEN
#
# Sampling (1.0 = 100%, 0.2 = 20%  default: 1.0 dev / 0.2 prod)
# OTEL_TRACES_SAMPLE_RATE=1.0
#
# Metrics export interval in ms (default: 30000 = 30 s)
# OTEL_METRICS_INTERVAL_MS=30000
#
# Diagnostic log level: none | error | warn | info | debug (default: warn)
# OTEL_LOG_LEVEL=warn
#
# ─── Quick-start backends ────────────────────────────────────────────────────
# Jaeger all-in-one (local dev):
#   docker run -d --name jaeger -p 16686:16686 -p 4318:4318 jaegertracing/all-in-one:latest
#   Then set: OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#   UI at: http://localhost:16686
#
# Grafana Tempo + Prometheus (docker compose included in docs/docker/):
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#
# Honeycomb.io (free tier, cloud):
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
#   OTEL_HEADERS=x-honeycomb-team=YOUR_KEY
#
# Datadog:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318  (via DD Agent)
#   OR OTEL_EXPORTER_OTLP_ENDPOINT=https://trace.agent.datadoghq.com
#   OTEL_HEADERS=dd-api-key=YOUR_KEY

# ── Run mode & background jobs ───────────────────────────────────────────────
# Production: RUN_MODE=api (HTTP) + RUN_MODE=worker (jobs) on separate pods.
#
# Local dev (recommended):
#   Terminal 1: npm run redis:up
#   Terminal 2: npm run dev:stack     ← API + worker together
#   OR split:   npm run dev           + npm run worker:dev (second terminal)
#
# REDIS_URL must point at a running Redis for refresh limits, cart sync, and jobs.
RUN_MODE=api
JOBS_ENABLED=true
# Dev API process: keep false (use npm run worker:dev or dev:stack). Production worker pod: true.
QUEUE_WORKERS_ENABLED=false
# Worker startup: verify SMTP/Resend transport (set false to skip verify ping)
# WORKER_VERIFY_EMAIL=true

# Bull Board — queue inspector at /api/admin/queues (admin auth still required). Off in local API dev.
BULL_BOARD_ENABLED=false

# BullMQ Redis retention (lower = less memory; jobs still run normally)
BULLMQ_REMOVE_ON_COMPLETE=300
BULLMQ_REMOVE_ON_FAIL=500

# ── Cron schedules (optional — override default poll intervals) ─────────────
INVENTORY_RECONCILE_CRON=0 2 * * *
NOTIFICATION_MAINTENANCE_CRON=0 3 * * *
# ANALYTICS_ROLLUP_CRON=0 2 * * *
# Serve dashboard 30d charts from AnalyticsDailySnapshot (default true in production)
ANALYTICS_USE_SNAPSHOTS=true
# SITEMAP_CRON=0 3 * * *
# EMBEDDING_BACKFILL_CRON=0 4 * * *
# EMBEDDING_REFRESH_CRON=0 5 * * 0
# REENGAGE_CRON=0 10 * * 1
# IMAGE_OPTIMIZE_CRON=0 2 * * *

# ── Standalone queue jobs (BullMQ) ───────────────────────────────────────────
EMBEDDING_BACKFILL_ENABLED=true
DELHIVERY_TRACK_SYNC_ENABLED=true
PAYMENT_RECOVERY_ENABLED=true
# DELHIVERY_TRACK_SYNC_MS=1200000
# PAYMENT_RECOVERY_MS=1800000
# EMBEDDING_BACKFILL_DELAY_MS=8000
# EMBEDDING_BACKFILL_PRODUCT_LIMIT=500
# EMBEDDING_BACKFILL_BLOG_LIMIT=200

# ── Critical job tuning ───────────────────────────────────────────────────────
CART_ABANDON_INACTIVE_MS=7200000
# CART_ABANDON_JOB_MS=3600000
# CART_ABANDON_COOLDOWN_MS=86400000
# CART_ABANDON_BATCH=50
UNPAID_ORDER_CANCEL_AFTER_MS=1800000
# UNPAID_ORDER_CANCEL_MS=900000
# UNPAID_ORDER_CANCEL_BATCH=25
REVIEW_INVITE_DELAY_MS=259200000
# REVIEW_INVITE_JOB_MS=3600000
# REVIEW_INVITE_BATCH=30
# REVIEW_INVITE_TTL_DAYS=90
OUTBOX_DLQ_MIN_ATTEMPTS=5
# OUTBOX_DLQ_ALERT_COOLDOWN_MS=7200000
# OUTBOX_DLQ_HANDLER_MS=1800000

# ── Important job tuning ──────────────────────────────────────────────────────
WISHLIST_PRICE_DROP_MIN_PCT=10
# WISHLIST_PRICE_DROP_JOB_MS=21600000
# WISHLIST_PRICE_DROP_BATCH=100
LOW_STOCK_THRESHOLD=3
# LOW_STOCK_ALERT_JOB_MS=7200000
ORDER_SLA_SHIP_MS=172800000
# ORDER_SLA_JOB_MS=3600000
SITEMAP_OUTPUT_PATH=./public/sitemap.xml
SITEMAP_CLOUDINARY_UPLOAD=true
# SITEMAP_CLOUDINARY_PUBLIC_ID=sitemap/sitemap

# ── Nice-to-have job tuning ───────────────────────────────────────────────────
RETURN_AUTO_APPROVE_MAX_AMOUNT=5000
RETURN_AUTO_APPROVE_AFTER_HOURS=48
# Comma-separated return reasons allowed for auto-approve (required when enabled)
RETURN_AUTO_APPROVE_REASONS=wrong_size,damaged,defective
# RETURN_AUTO_APPROVE_MS=7200000
EMBEDDING_STALE_DAYS=7
REENGAGE_INACTIVE_DAYS=30
# REENGAGE_BATCH=100
# REENGAGE_COOLDOWN_DAYS=30

# ── Per-job enable toggles (unset or not "false" = enabled, except risky jobs) ─
# CART_ABANDON_JOB_ENABLED=true
# UNPAID_ORDER_CANCEL_ENABLED=true
# REVIEW_INVITE_JOB_ENABLED=true
# COUPON_EXPIRE_JOB_ENABLED=true
# SALE_EXPIRE_JOB_ENABLED=true
# OUTBOX_DLQ_HANDLER_ENABLED=true
# WISHLIST_PRICE_DROP_JOB_ENABLED=true
# LOW_STOCK_ALERT_JOB_ENABLED=true
# ORDER_SLA_JOB_ENABLED=true
# SESSION_CLEANUP_JOB_ENABLED=true
# SITEMAP_JOB_ENABLED=true
# ANALYTICS_ROLLUP_JOB_ENABLED=true
# EMBEDDING_REFRESH_JOB_ENABLED=true
# INVENTORY_RECONCILE_ENABLED=true
# NOTIFICATION_MAINTENANCE_ENABLED=true

# Risky / opt-in only — must be explicitly true to run
RETURN_AUTO_APPROVE_ENABLED=false
REENGAGE_JOB_ENABLED=false
IMAGE_OPTIMIZE_JOB_ENABLED=false
